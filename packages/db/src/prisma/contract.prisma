// use prisma-8

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  password      String
  name          String?
  creditsUsd    Float         @default(5.0) // $5 free starting credits
  refreshTokens RefreshToken[]
  projects      Project[]
  providerKeys  ProviderKey[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}


model RefreshToken {
  id          Int               @id @default(autoincrement())
  tokenHash   String            @unique // SHA-256 hash of the refresh token
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  userAgent   String?           // e.g. "Chrome on Windows"
  ipAddress   String?           // For fraud / session tracking
  expiresAt   TimestamptzString // When this token expires
  revokedAt   TimestamptzString?// Null if active; timestamp when logged out
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Project {
  id           Int           @id @default(autoincrement())
  name         String        // e.g. "Default Project", "Production"
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  apiKeys      GatewayKey[]
  usageRecords UsageRecord[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model GatewayKey {
  id            Int           @id @default(autoincrement())
  name          String        // e.g. "Production Key"
  prefix        String        // e.g. "gw_live_4f92" for UI display
  secretHash    String        @unique // SHA-256 hash of secret
  projectId     Int
  project       Project       @relation(fields: [projectId], references: [id])
  rateLimitRpm  Int           @default(60)
  monthlyCapUsd Float?
  status        String        @default("active") // "active" | "revoked"
  expiresAt     TimestamptzString?
  usageRecords  UsageRecord[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model ProviderKey {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  provider     String   // "openai" | "anthropic" | "gemini" | "groq"
  encryptedKey String   // AES-256 encrypted key
  keyPreview   String   // e.g. "sk-...ab12"
  isActive     Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model ModelDeployment {
  id            Int      @id @default(autoincrement())
  alias         String   // e.g. "smart-chat", "fast-chat"
  provider      String   // "openai", "anthropic", "gemini", "groq"
  providerModel String   // e.g. "gpt-4o", "claude-3-5-sonnet-20241022"
  priority      Int      @default(1) // 1 = Primary, 2 = Fallback 1, 3 = Fallback 2
  enabled       Boolean  @default(true)
  config        String?  // Optional JSON parameters
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model UsageRecord {
  id               Int      @id @default(autoincrement())
  requestId        String   @unique // e.g. "req_7f2d91"
  projectId        Int?
  project          Project? @relation(fields: [projectId], references: [id])
  apiKeyId         Int?
  apiKey           GatewayKey? @relation(fields: [apiKeyId], references: [id])
  modelAlias       String   // e.g. "smart-chat"
  provider         String   // "openai", "gemini", etc.
  providerModel    String   // e.g. "claude-3-5-sonnet"
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0.0)
  latencyMs        Int?
  ttftMs           Int?     // Time to first token (streaming)
  status           String   @default("success") // "success" | "error"
  statusCode       Int      @default(200)
  isCached         Boolean  @default(false)
  usedCustomKey    Boolean  @default(false)
  errorMessage     String?
  createdAt        TimestamptzString @default(now())
}
